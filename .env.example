# KnowledgeVault — local development environment
# Copy this file to .env before running docker compose

# Infrastructure Services (Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledgevault
POSTGRES_USER=kv_user
POSTGRES_PASSWORD=KvDb2024!

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=KvRedis2024!

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant_key_2024

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=kv_user
RABBITMQ_PASS=KvRabbit2024!

