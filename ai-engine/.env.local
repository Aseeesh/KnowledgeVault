# ─── Ollama (Local) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
EMBEDDING_MODEL=nomic-embed-text

# ─── Qdrant ──────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333
QDRANT_API_KEY=qdrant_key_2024

# ─── Redis ───────────────────────────────────────────────────────
# ✅ FIXED: Proper Redis URL format
REDIS_URL=redis://default:KvRedis2024!@localhost:6379/1

# ─── PostgreSQL ─────────────────────────────────────────────────
# ✅ FIXED: AsyncPG DSN format
POSTGRES_DSN=postgresql+asyncpg://kv_user:KvDev2024!@localhost:5432/knowledgevault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledgevault
POSTGRES_USER=kv_user
POSTGRES_PASSWORD=KvDev2024!

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

# ─── Embedding Settings ──────────────────────────────────────────
EMBEDDING_BATCH_SIZE=32
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─── LLM Settings ────────────────────────────────────────────────
MAX_TOKENS=2048
TEMPERATURE=0.7
TOP_P=0.9

# ─── Search Settings ─────────────────────────────────────────────
HYBRID_SEARCH_TOP_K=10
RRF_CONSTANT=60
SIMILARITY_THRESHOLD=0.78

# ─── Server Settings ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=True

# ─── API URL ─────────────────────────────────────────────────────
API_URL=http://localhost:5001
AI_ENGINE_URL=http://localhost:8000