{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=${POSTGRES_HOST:-localhost};Port=${POSTGRES_PORT:-5432};Database=${POSTGRES_DB:-knowledgevault};Username=${POSTGRES_USER:-kv_user};Password=${POSTGRES_PASSWORD:-KvDev2024!}"
  },
  "Redis": {
    "ConnectionString": "${REDIS_HOST:-localhost}:${REDIS_PORT:-6379},password=${REDIS_PASSWORD:-KvRedis2024!}"
  },
  "RabbitMQ": {
    "Host": "${RABBITMQ_HOST:-localhost}",
    "Port": "${RABBITMQ_PORT:-5672}",
    "Username": "${RABBITMQ_USER:-kv_user}",
    "Password": "${RABBITMQ_PASSWORD:-KvRabbit2024!}"
  },
  "Qdrant": {
    "Host": "${QDRANT_HOST:-localhost}",
    "HttpPort": "${QDRANT_PORT:-6333}",
    "GrpcPort": "${QDRANT_GRPC_PORT:-6334}",
    "ApiKey": "${QDRANT_API_KEY:-qdrant_key_2024}"
  },
  "AIEngine": {
    "BaseUrl": "${AI_ENGINE_URL:-http://localhost:8000}"
  }
}